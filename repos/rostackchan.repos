repositories:
  feetech_scs_ros2_driver:
    type: git
    url: https://github.com/Ar-Ray-code/feetech_scs_ros2_driver.git
    version: main
  rostack-chan:
    type: git
    url: https://github.com/Ar-Ray-code/rostack-chan.git
    version: main
  h6x_serial_interface:
    type: git
    url: https://github.com/HarvestX/h6x_serial_interface.git
    version: humble
  diagnostics:
    type: git
    url: https://github.com/ros/diagnostics.git
    version: ros2-jazzy
  ros2_control:
    type: git
    url: https://github.com/ros-controls/ros2_control.git
    version: iron
  control_msgs:
    type: git
    url: https://github.com/ros-controls/control_msgs.git
    version: iron
  backward_ros:
    type: git
    url: https://github.com/pal-robotics/backward_ros.git
    version: foxy-devel
  realtime_tools:
    type: git
    url: https://github.com/ros-controls/realtime_tools.git
    version: 4.2.0
  xacro:
    type: git
    url: https://github.com/ros/xacro.git
    version: ros2
  ros2_controllers:
    type: git
    url: https://github.com/ros-controls/ros2_controllers.git
    version: iron
  angles:
    type: git
    url: https://github.com/ros/angles.git
    version: 1.16.0
  control_toolbox:
    type: git
    url: https://github.com/ros-controls/control_toolbox.git
    version: 5.1.0
  filters:
    type: git
    url: https://github.com/ros/filters.git
    version: ros2
  ackermann_msgs:
    type: git
    url: https://github.com/ros-drivers/ackermann_msgs.git
    version: ros2
  kinematics_interface:
    type: git
    url: https://github.com/ros-controls/kinematics_interface.git
    version: 2.0.0
  generate_parameter_library:
    type: git
    url: https://github.com/PickNikRobotics/generate_parameter_library.git
    version: 0.4.0
  cpp_polyfills:
    type: git
    url: https://github.com/PickNikRobotics/cpp_polyfills.git
    version: 1.0.2
  RSL:
    type: git
    url: https://github.com/PickNikRobotics/RSL.git
    version: 1.1.0
  dynamixel_hardware:
    type: git
    url: https://github.com/dynamixel-community/dynamixel_hardware.git
    version: jazzy
  DynamixelSDK:
    type: git
    url: https://github.com/ROBOTIS-GIT/DynamixelSDK.git
    version: humble-devel
  dynamixel-workbench:
    type: git
    url: https://github.com/ROBOTIS-GIT/dynamixel-workbench.git
    version: humble-devel
